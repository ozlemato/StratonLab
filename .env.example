# Domaine réel HTTPS, sans chemin. Laisser vide en local.
SITE_URL=
# Activer seulement après validation éditoriale et juridique.
SITE_INDEXABLE=false
# Adresse réelle de contact. Active la préparation d'un e-mail, jamais un envoi automatique.
CONTACT_EMAIL=
# Activer uniquement sur un domaine effectivement servi en HTTPS.
ENABLE_HSTS=false
# Contrôles axe intégrés à l'aperçu local uniquement.
QA_CHECKS=false
